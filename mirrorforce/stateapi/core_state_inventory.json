    "pending_public": "Pending flow normalized into CHAIN/BATTLE/PENDING_PUBLIC.",
    "derived": "Reconstructed without loss from another exported field.",
    "static_semantics": "Represented by English card text or Lua effect semantics, not raw refs.",
    "omniscient_label": "Offline label only; never a policy input before disclosure.",
    "hidden": "Game-hidden information excluded from player observations.",
    "transient": "Processor work state that cannot survive to a stable decision point.",
    "internal": "Implementation id, pointer, index, cache or response buffer.",
    "mode_specific": "Unsupported duel mode state retained only for explicit future modes."
